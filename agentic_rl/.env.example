# Never commit real credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_USER_MODEL=FIX_EXACT_MODEL_ID
# Agent reward Judge: RL defaults on, pass evaluation defaults off.
DEEPSEEK_JUDGE_MODEL=FIX_EXACT_MODEL_ID
# Separate outcome-blind User Simulator compliance judge; required for RL/eval.
# May use the same exact model ID as DEEPSEEK_JUDGE_MODEL, with a separate prompt/cache.
DEEPSEEK_USER_SIM_JUDGE_MODEL=FIX_EXACT_MODEL_ID
MERGED_SFT_MODEL=/path/to/merged_sft_model
TAU2_ROOT=/path/to/tau2-bench
VERL_ROOT=/path/to/verl
WANDB_API_KEY=
TRAJECTORY_OUTPUT_DIR=outputs/trajectories
JUDGE_CACHE_DIR=outputs/judge_cache
USER_CACHE_DIR=outputs/user_cache
USER_SIM_JUDGE_CACHE_DIR=outputs/user_sim_judge_cache
