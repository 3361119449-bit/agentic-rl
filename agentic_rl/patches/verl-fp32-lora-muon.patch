 device_name = get_device_name()
 
 
+@contextmanager
+def _lora_matrix_views(matrices):
+    """Expose each single-matrix flat parameter to native Muon only during its call."""
+    saved = []
+    try:
+        for parameter, shape in matrices:
+            # FSDP owns this Parameter. Keep its identity and storage, and restore
+            # its flat gradient and data before FSDP or checkpointing sees it.
+            flat, grad = parameter.detach(), parameter.grad
+            data_view = flat.view(shape)
+            grad_view = grad.view(shape) if grad is not None else None
+            saved.append((parameter, flat, grad))
+            parameter.grad = None
+            parameter.data = data_view
+            parameter.grad = grad_view
+        yield
+    finally:
+        for parameter, flat, grad in saved:
+            parameter.grad = None
+            parameter.data = flat
+            parameter.grad = grad
+
