+    def _cap_micro_batches(self, data, micro_batches, partitions, token_budget):
+        """Split oversized partitions without changing sample order or the loss denominator."""
+        if (
+            self.get_data_parallel_size() != 1
+            or self.ulysses_sequence_parallel_size != 1
+            or tu.get_non_tensor_data(data=data, key="force_group_size", default=1) != 1
+            or partitions is None
+            or not data["input_ids"].is_nested
+        ):
+            raise ValueError("Strict token cap requires single-GPU dynamic batches with packed inputs")
+
+        lengths = data["input_ids"].offsets().diff().tolist()
+        if max(lengths) > token_budget:
+            raise ValueError("A sequence exceeds the hard micro-batch token limit")
+        capped_batches, capped_partitions = [], []
+        for micro_batch, partition in zip(micro_batches, partitions, strict=True):
+            if sum(lengths[index] for index in partition) <= token_budget:
+                capped_batches.append(micro_batch)
+                capped_partitions.append(partition)
+                continue
+            current, used = [], 0
+            for index in partition:
+                length = lengths[index]
+                if current and used + length > token_budget:
+                    capped_batches.append(tu.index_select_tensor_dict(data, current))
+                    capped_partitions.append(current)
+                    current, used = [], 0
+                current.append(index)
+                used += length
+            capped_batches.append(tu.index_select_tensor_dict(data, current))
+            capped_partitions.append(current)
+        return capped_batches, capped_partitions
+
     def forward_backward_batch(self, data: TensorDict, loss_function: Callable, forward_only=False) -> list[TensorDict]:
